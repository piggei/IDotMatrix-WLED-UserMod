{
  "name": "wled-usermod-idotmatrix",
  "version": "0.9.0-rc.1",
  "description": "iDotMatrix BLE server/emulator usermod for WLED with ESP32-S3/HUB75 64x64 support",
  "keywords": [
    "wled",
    "idotmatrix",
    "ble",
    "esp32",
    "esp32-c3",
    "esp32-wrover",
    "psram",
    "esp32-s3",
    "hub75",
    "matrixportal"
  ],
  "license": "EUPL-1.2",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": {
    "bitbank2/AnimatedGIF": "1.4.7"
  },
  "build": {
    "libArchive": false,
    "srcDir": ".",
    "srcFilter": [
      "+<*.cpp>"
    ],
    "extraScript": "patch_animatedgif_profiles.py"
  }
}
