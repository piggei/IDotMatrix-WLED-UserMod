; WLED iDotMatrix Usermod - ESP32-C3 16x16 + AudioReactive development profile
; Usermod build: 0.8.2-rc.2
; Required WLED base commit:
;   d55037f7510541eddc390c8f3d01afc5787aa44a (2026-09-07)
;
; This profile is intentionally separate from platformio_override.ini.c3.
; It adds WLED AudioReactive to the already validated IDF5/shared-RMT C3 stack
; so iDotMatrix Audio/Rhythm visualizers can optionally use WLED's local audio
; data instead of the phone microphone stream.
;
; AudioReactive remains runtime-configurable in WLED. This profile includes the
; Usermod but does not force it enabled or prescribe microphone GPIOs.

[env:esp32c3dev_idotmatrix_audio_16x16]
extends = env:esp32c3dev
board_build.partitions = ../wled-usermod-idotmatrix/WLED_ESP32_4MB_IDOT_NO_OTA.csv

build_flags =
  ${env:esp32c3dev.build_flags}
  -D WLED_DISABLE_OTA
  -D IDOT_GIF_LZW12
  -D IDOT_SCREEN_MAX_DIM=16
  -D IDOT_C3_WLED_IDF5
  -D WLED_DISABLE_ALEXA
  -D WLED_DISABLE_HUESYNC
  -D WLED_DISABLE_MQTT
  -D WLED_DISABLE_INFRARED
  -D WLED_DISABLE_ADALIGHT
  -D WLED_DISABLE_LOXONE

lib_deps =
  ${env:esp32c3dev.lib_deps}
  h2zero/NimBLE-Arduino@2.5.1
  bitbank2/AnimatedGIF@1.4.7

custom_usermods =
  audioreactive
  symlink://../wled-usermod-idotmatrix
