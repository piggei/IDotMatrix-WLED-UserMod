; WLED iDotMatrix Usermod - stable 16x16 profile
; Target baseline: WLED v16.0.1.
;
; This profile deliberately uses the stable compact12/cache decoder while the
; settings UI is constrained to 16x16.  The decoder workspace and the visible
; ScreenType choices are independent through IDOT_SCREEN_MAX_DIM.
;
; All iDotMatrix environments deliberately use Espressif Arduino 2.0.17 /
; ESP-IDF 4.4.7 (espressif32 ~6.13.0). WLED's default Tasmota framework does
; not expose the complete BLE GATT server required by this Usermod.
;
; OTA is disabled and the supplied single-app partition tables are used.
; The lean feature set is intentional: it preserves heap for NimBLE/media and
; avoids inheriting WLED's default AudioReactive usermod.
;
; IMPORTANT: custom_usermods contains ONLY the iDotMatrix symlink. Do not add
; ${env:<base>.custom_usermods}; WLED base environments can pull AudioReactive.

[env:esp32dev_idotmatrix_16x16]
extends = env:esp32dev
platform = espressif32@~6.13.0
platform_packages =
board_build.partitions = ../wled-usermod-idotmatrix/WLED_ESP32_4MB_IDOT_NO_OTA.csv

build_flags =
  ${env:esp32dev.build_flags}
  -D WLED_DISABLE_OTA
  -D IDOT_GIF_LZW12
  -D IDOT_SCREEN_MAX_DIM=16
  -D WLED_DISABLE_ALEXA
  -D WLED_DISABLE_HUESYNC
  -D WLED_DISABLE_MQTT
  -D WLED_DISABLE_INFRARED
  -D WLED_DISABLE_ADALIGHT
  -D WLED_DISABLE_ESPNOW
  -D WLED_DISABLE_LOXONE

lib_deps =
  ${env:esp32dev.lib_deps}
  h2zero/NimBLE-Arduino@1.4.3
  bitbank2/AnimatedGIF@1.4.7

custom_usermods =
  symlink://../wled-usermod-idotmatrix

