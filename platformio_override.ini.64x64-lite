  ${env:esp32dev_8M.build_flags}
  -D WLED_DISABLE_OTA
  -D IDOT_GIF_LZW12
  -D WLED_DISABLE_ALEXA
  -D WLED_DISABLE_HUESYNC
  -D WLED_DISABLE_MQTT
  -D WLED_DISABLE_INFRARED
  -D WLED_DISABLE_ADALIGHT
  -D WLED_DISABLE_ESPNOW
  -D WLED_DISABLE_LOXONE

lib_deps =
  ${env:esp32dev_8M.lib_deps}
  h2zero/NimBLE-Arduino@1.4.3
  bitbank2/AnimatedGIF@1.4.7

custom_usermods =
  ; Intentionally do NOT inherit ${env:esp32dev_8M.custom_usermods}.
  wled-usermod-idotmatrix = symlink://../wled-usermod-idotmatrix

[env:esp32dev_16M_idotmatrix]
extends = env:esp32dev_16M
platform = espressif32@~6.13.0
platform_packages =
board_build.partitions = ../wled-usermod-idotmatrix/WLED_ESP32_16MB_IDOT_NO_OTA.csv

build_flags =
  ${env:esp32dev_16M.build_flags}
  -D WLED_DISABLE_OTA
  -D IDOT_GIF_LZW12
  -D WLED_DISABLE_ALEXA
  -D WLED_DISABLE_HUESYNC
  -D WLED_DISABLE_MQTT
  -D WLED_DISABLE_INFRARED
  -D WLED_DISABLE_ADALIGHT
  -D WLED_DISABLE_ESPNOW
  -D WLED_DISABLE_LOXONE

lib_deps =
  ${env:esp32dev_16M.lib_deps}
  h2zero/NimBLE-Arduino@1.4.3
  bitbank2/AnimatedGIF@1.4.7

