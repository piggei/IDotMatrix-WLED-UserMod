; iDotMatrix 64x64 low-RAM profile for classic ESP32 without PSRAM.
; This is the hardware-validated 0.7.1 configuration for 64x64 logical ->
; smaller physical rescale. It removes optional WLED integrations to increase
; the internal-RAM margin available during compact12 frame-cache preparation.
[env:esp32dev_idotmatrix]
extends = env:esp32dev

platform = espressif32@~6.13.0
platform_packages =
board_build.partitions = ../wled-usermod-idotmatrix/WLED_ESP32_4MB_IDOT_NO_OTA.csv

build_flags =
  ${env:esp32dev.build_flags}
  -D WLED_DISABLE_OTA
  -D IDOT_GIF_LZW12
  -D WLED_DISABLE_ALEXA
  -D WLED_DISABLE_HUESYNC
  -D WLED_DISABLE_MQTT
  -D WLED_DISABLE_INFRARED
  -D WLED_DISABLE_ADALIGHT
  -D WLED_DISABLE_ESPNOW
  -D WLED_DISABLE_LOXONE

; WebSockets, JSON API, 2D engine, presets, playlists, UDP realtime/DDP/E1.31
; and normal WLED effects remain enabled. This profile is for measurement;
; features should only be removed permanently after hardware validation.
lib_deps =
  ${env:esp32dev.lib_deps}
  h2zero/NimBLE-Arduino@1.4.3
  bitbank2/AnimatedGIF@1.4.7

custom_usermods =
  wled-usermod-idotmatrix = symlink://../wled-usermod-idotmatrix
